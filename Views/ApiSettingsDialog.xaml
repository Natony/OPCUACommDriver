<Window x:Class="OpcUaCommunicationEngine.Views.ApiSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình API Server"
        Height="590" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FontSans}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="12"
            BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- header -->
                <RowDefinition Height="*"/>     <!-- body -->
                <RowDefinition Height="Auto"/>  <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ======== Header ======== -->
            <Grid Grid.Row="0" Margin="24,20,16,0" MouseLeftButtonDown="Head_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                        Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="20" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Cấu hình API Server" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Địa chỉ và cổng REST API nội bộ"
                               FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Width="32" Height="32"
                        Click="Cancel_Click" Content="✕"/>
            </Grid>

            <!-- ======== Body ======== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,18">
                <StackPanel>

                    <!-- Enable toggle -->
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="EnabledCheckBox" IsChecked="True" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Bật API Server" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Cho phép truy cập dữ liệu PLC qua REST API"
                                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bind address section -->
                    <TextBlock Text="ĐỊA CHỈ BIND" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>

                            <!-- Suggestion info -->
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="#F3D871" BorderThickness="1">
                                <TextBlock x:Name="SuggestionTextBlock"
                                           Text="Gợi ý địa chỉ dựa trên cấu hình PLC"
                                           FontSize="11" TextWrapping="Wrap" Foreground="#8A5200"/>
                            </Border>

                            <!-- Address input + quick-set buttons -->
                            <TextBlock Text="Địa chỉ *" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="BindAddressTextBox"
                                         Style="{StaticResource MonoTextBox}" Height="34" Text="0.0.0.0"/>
                                <Button Grid.Column="2" x:Name="UseSuggestionButton"
                                        Style="{StaticResource SecondaryButton}" Height="34"
                                        Content="Gợi ý" Click="UseSuggestion_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Height="34"
                                        Content="Tất cả" ToolTip="Bind trên mọi interface (0.0.0.0)"
                                        Click="SetAllInterfaces_Click"/>
                                <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Height="34"
                                        Content="Local" ToolTip="Chỉ local (127.0.0.1)"
                                        Click="SetLocalhost_Click"/>
                            </Grid>

                            <!-- Available IPs -->
                            <TextBlock Text="IP hiện có trên máy này" Style="{StaticResource FieldLabel}"/>
                            <Border BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1"
                                    CornerRadius="6" Background="White">
                                <ListBox x:Name="LocalIpListBox"
                                         Height="78"
                                         BorderThickness="0" Background="Transparent"
                                         SelectionChanged="LocalIpListBox_SelectionChanged"
                                         FontFamily="{StaticResource FontMono}" FontSize="12"
                                         Padding="4"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Port section -->
                    <TextBlock Text="CỔNG (PORT)" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Port *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PortTextBox" Style="{StaticResource MonoTextBox}"
                                         Height="34" Text="5000"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Khoảng hợp lệ: 1024 – 65535"
                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Bottom" Margin="12,0,0,8"/>
                        </Grid>
                    </Border>

                    <!-- PLC list section -->
                    <TextBlock Text="PLC PHÁT HIỆN" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
                    <Border BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1"
                            CornerRadius="8" Background="#FAFAFA">
                        <ListBox x:Name="PlcListBox"
                                 BorderThickness="0" Background="Transparent"
                                 MaxHeight="110" Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EndpointUrl}"
                                                   FontFamily="{StaticResource FontMono}" FontSize="11"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======== Footer ======== -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid Margin="20,12">
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}">
                        <Run Text="Esc"/> <Run Text=" huỷ"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolbarButton}" Content="Huỷ" Click="Cancel_Click"/>
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                                Content="Lưu cài đặt" Click="Save_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
