<Window x:Class="OpcUaCommunicationEngine.Views.ApiSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Server Settings"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="API Server Configuration"
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Enable/Disable API -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <CheckBox x:Name="EnabledCheckBox"
                      Content="Enable API Server"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Bind Address Section -->
        <GroupBox Grid.Row="2" Header="Bind Address" Margin="0,0,0,16" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Suggestion Info -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           x:Name="SuggestionTextBlock"
                           Text="Suggestion based on PLC configuration"
                           FontStyle="Italic"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <!-- Address Input -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Address:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="BindAddressTextBox"
                             Text="0.0.0.0"
                             Padding="8,6"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="UseSuggestionButton"
                            Content="Use Suggestion"
                            Padding="8,6"
                            Margin="8,0,0,0"
                            Click="UseSuggestion_Click"/>
                </Grid>

                <!-- Quick Options -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <TextBlock Text="Quick:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="All Interfaces (0.0.0.0)"
                            Padding="6,4" Margin="0,0,4,0"
                            Click="SetAllInterfaces_Click"/>
                    <Button Content="Localhost Only"
                            Padding="6,4" Margin="0,0,4,0"
                            Click="SetLocalhost_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Port Section -->
        <GroupBox Grid.Row="3" Header="Port" Margin="0,0,0,16" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Port:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <TextBox Grid.Column="1"
                         x:Name="PortTextBox"
                         Text="5000"
                         Padding="8,6"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="(1024-65535)"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- PLC List Info -->
        <GroupBox Grid.Row="4" Header="Detected PLCs" Padding="8">
            <ListBox x:Name="PlcListBox"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="120"/>
                            <TextBlock Text="{Binding EndpointUrl}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    Style="{StaticResource PrimaryButton}"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
