<Window x:Class="OpcUaCommunicationEngine.Views.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:OpcUaCommunicationEngine.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="User Details"
        Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <ObjectDataProvider x:Key="UserRoleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:UserRole"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Add New User"
                   FontSize="18" FontWeight="SemiBold" Foreground="#333"
                   Margin="0,0,0,20"/>

        <!-- Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Username -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <TextBox x:Name="UsernameTextBox" Grid.Row="0" Grid.Column="1"
                     Padding="8,6" Margin="0,0,0,12"/>

            <!-- Password (only for new users) -->
            <TextBlock x:Name="PasswordLabel" Grid.Row="1" Grid.Column="0" Text="Password:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1"
                         Padding="8,6" Margin="0,0,0,12"/>

            <!-- Display Name -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Display Name:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <TextBox x:Name="DisplayNameTextBox" Grid.Row="2" Grid.Column="1"
                     Padding="8,6" Margin="0,0,0,12"/>

            <!-- Role -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Role:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <ComboBox x:Name="RoleComboBox" Grid.Row="3" Grid.Column="1"
                      ItemsSource="{Binding Source={StaticResource UserRoleValues}}"
                      Padding="8,6" Margin="0,0,0,12"/>

            <!-- Lock Duration -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Lock Duration:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="LockDurationTextBox" Width="80" Padding="8,6"/>
                    <TextBlock Text=" minutes" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="(Empty=Default, 0=Unlimited)" FontSize="10" Foreground="#666" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Active -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Active:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <CheckBox x:Name="IsActiveCheckBox" Grid.Row="5" Grid.Column="1"
                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,12"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"
                    Background="#757575" Foreground="White" BorderThickness="0" Width="80"/>
            <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Padding="16,8"
                    Background="#4CAF50" Foreground="White" BorderThickness="0" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
