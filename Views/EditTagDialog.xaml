<Window x:Class="OpcUaCommunicationEngine.Views.EditTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit Tag"
        Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Identity Section -->
                <TextBlock Text="Identity" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Name *"/>
                        <TextBox x:Name="TxtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Description"/>
                        <TextBox x:Name="TxtDescription" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>
                    </StackPanel>
                </Border>

                <!-- OPC UA Section -->
                <TextBlock Text="OPC UA Node" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Node ID *"/>
                        <TextBox x:Name="TxtNodeId" Text="{Binding NodeId, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Display Name"/>
                        <TextBox x:Name="TxtDisplayName" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Browse Path"/>
                        <TextBox x:Name="TxtBrowsePath" Text="{Binding BrowsePath, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Data Type"/>
                        <ComboBox x:Name="CmbDataType"/>

                        <Label Content="Access Mode"/>
                        <ComboBox x:Name="CmbAccessMode"/>

                        <CheckBox x:Name="ChkIsEnabled" Content="Enabled" IsChecked="{Binding IsEnabled}"/>
                    </StackPanel>
                </Border>

                <!-- Subscription Section -->
                <TextBlock Text="Subscription" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Scan Rate (ms)"/>
                        <TextBox x:Name="TxtScanRate" Text="{Binding ScanRate, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Deadband"/>
                        <TextBox x:Name="TxtDeadband" Text="{Binding Deadband, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- Engineering Section -->
                <TextBlock Text="Engineering" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Engineering Unit"/>
                        <TextBox x:Name="TxtEngineeringUnit" Text="{Binding EngineeringUnit, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Min Value"/>
                                <TextBox x:Name="TxtMinValue"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Max Value"/>
                                <TextBox x:Name="TxtMaxValue"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="Array Size (0 = scalar)"/>
                        <TextBox x:Name="TxtArraySize" Text="{Binding ArraySize, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="80" Padding="10,5" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Padding="10,5" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
