<!--
  LoginWindow.xaml — Junction sign-in surface
  Path: Views/LoginWindow.xaml
  Wire-up: in App.xaml.cs OnStartup, show LoginWindow first; on successful sign-in
  the LoginViewModel resolves MainWindow from DI, shows it, and closes LoginWindow.
-->
<Window x:Class="OpcUaCommunicationEngine.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Junction — Sign in"
        Height="640" Width="960"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource FontSans}">

    <Window.Resources>
        <Style x:Key="LangPill" TargetType="TextBlock">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ LEFT: dark brand panel ============ -->
        <Grid Grid.Column="0" Background="{StaticResource ChromeNavyBrush}">
            <!-- soft radial glow accents (top-right blue, bottom-left yellow) -->
            <Ellipse Width="500" Height="500" Margin="0,-150,-150,0"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                        <GradientStop Color="#0F1419" Offset="0.7"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="400" Height="400" Margin="-100,0,0,-150"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                        <GradientStop Color="#0F1419" Offset="0.7"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="56" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                        <Grid>
                            <TextBlock Text="JN" Foreground="White"
                                       FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Height="3" Fill="{StaticResource AccentBrush}" RadiusX="2" RadiusY="2"
                                       Margin="10,0,10,7" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Junction" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource TextDisabledBrush}"
                                   FontFamily="{StaticResource FontMono}" FontSize="10" Margin="0,4,0,0">
                            <Run Text="PLC "/>
                            <Run Text="↔" Foreground="{StaticResource AccentBrush}"/>
                            <Run Text=" DEVICE MIDDLEWARE"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Quote -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Foreground="White" FontSize="22" FontWeight="Medium"
                               TextWrapping="Wrap" LineHeight="30"
                               Text="Một cổng giao tiếp duy nhất giữa PLC nhà máy và mọi thiết bị ngoại vi cần dữ liệu."/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Rectangle Width="24" Height="1" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Margin="10,0,0,0"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   FontFamily="{StaticResource FontMono}" FontSize="10"
                                   Text="AVS INDUSTRIAL SOFTWARE · v1.0.0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer stats -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Foreground="White" FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="SemiBold">
                                <Run Text="12"/><Run Text="+" Foreground="{StaticResource AccentBrush}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontFamily="{StaticResource FontMono}" FontSize="9" Text="PLC DRIVERS" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Foreground="White" FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="SemiBold" Text="50K"/>
                            <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontFamily="{StaticResource FontMono}" FontSize="9" Text="TAGS / SESSION" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="White" FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="SemiBold">
                                <Run Text="25K"/><Run Text="/s" Foreground="{StaticResource AccentBrush}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontFamily="{StaticResource FontMono}" FontSize="9" Text="UPDATES" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Foreground="#4B5563" FontFamily="{StaticResource FontMono}" FontSize="10"
                               Text="BUILD 2026.05.24"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ RIGHT: sign-in form ============ -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">

            <!-- AVS parent-brand pill in top-right corner -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,24,28,0"
                    Padding="10,4"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1"
                    CornerRadius="999">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="A PRODUCT OF" FontFamily="{StaticResource FontMono}" FontSize="9"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="·" Foreground="{StaticResource BorderStrongBrush}" Margin="6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="AVS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="14" Fill="{StaticResource AccentBrush}" Margin="6,0,4,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="INDUSTRIAL" FontFamily="{StaticResource FontMono}" FontSize="7" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="SOFTWARE"   FontFamily="{StaticResource FontMono}" FontSize="7" Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Window controls (since WindowStyle=None) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0">
                <Button Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="Minimize_Click">
                    <TextBlock Text="—" FontSize="13"/>
                </Button>
                <Button Width="28" Height="28" Style="{StaticResource ToolbarButton}" Click="Close_Click">
                    <TextBlock Text="✕" FontSize="13"/>
                </Button>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Margin="0,0,0,40">

                <!-- Language switch -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="0">
                        <TextBlock Text="VI" Style="{StaticResource LangPill}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="EN" Style="{StaticResource LangPill}" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Heading -->
                <TextBlock Text="Đăng nhập" Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontSansDisplay}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" Margin="0,6,0,28"
                           TextWrapping="Wrap"
                           Text="Đăng nhập vào Junction để kết nối và quản lý các PLC trong dây chuyền."/>

                <!-- Username -->
                <TextBlock Text="Tên đăng nhập" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBox x:Name="UserBox" Height="38" Padding="12,0" Text="engineer@avs"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,5"/>
                <Grid>
                    <PasswordBox x:Name="PasswordBox" Height="38" Padding="12,0"
                                 FontFamily="{StaticResource FontSans}" FontSize="13"
                                 BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"/>
                </Grid>

                <!-- Remember + forgot -->
                <Grid Margin="0,14,0,24">
                    <CheckBox VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" IsChecked="True">
                        <TextBlock Text="Ghi nhớ tôi trên thiết bị này"/>
                    </CheckBox>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"
                               TextDecorations="Underline"
                               Text="Quên mật khẩu?"/>
                </Grid>

                <!-- Sign in -->
                <Button Style="{StaticResource PrimaryButton}" Height="42" Click="SignIn_Click" Content="Đăng nhập"/>

                <!-- Status -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Margin="6,0,0,0" FontFamily="{StaticResource FontMono}" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="Máy chủ Junction đang hoạt động · ping 12 ms"/>
                </StackPanel>

                <!-- Error placeholder -->
                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" FontSize="12"
                           Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
