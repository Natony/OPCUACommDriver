<Window x:Class="OpcUaCommunicationEngine.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Reset Password"
        Height="260" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reset Password" FontSize="18" FontWeight="SemiBold" Foreground="#333"/>
            <TextBlock x:Name="UsernameText" Text="for user: admin"
                       FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- New Password -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="New Password:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                <PasswordBox x:Name="NewPasswordBox" Padding="8,6"/>
                <TextBox x:Name="NewPasswordTextBox" Padding="8,6" Visibility="Collapsed"/>
            </Grid>

            <!-- Confirm Password -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Confirm:"
                       VerticalAlignment="Center" Margin="0,0,8,12"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                <PasswordBox x:Name="ConfirmPasswordBox" Padding="8,6"/>
                <TextBox x:Name="ConfirmPasswordTextBox" Padding="8,6" Visibility="Collapsed"/>
            </Grid>

            <!-- Show Password -->
            <CheckBox x:Name="ShowPasswordCheckBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Hiện mật khẩu" Margin="0,0,0,8"
                      Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"
                    Background="#757575" Foreground="White" BorderThickness="0" Width="80"/>
            <Button Content="Reset" Click="Reset_Click" Padding="16,8"
                    Background="#9C27B0" Foreground="White" BorderThickness="0" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
