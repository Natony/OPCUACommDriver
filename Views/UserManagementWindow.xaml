<Window x:Class="OpcUaCommunicationEngine.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="User Management"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="User Management" FontSize="20" FontWeight="SemiBold" Foreground="#333"/>
            <TextBlock Text="Manage user accounts and permissions" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
            <Button x:Name="AddUserButton" Click="AddUser_Click" Padding="12,6" Margin="0,0,8,0"
                    Background="#4CAF50" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock Text="Add User"/>
                </StackPanel>
            </Button>
            <Button x:Name="RefreshButton" Click="Refresh_Click" Padding="12,6"
                    Background="#2196F3" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↻" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- User List -->
        <Border Grid.Row="1" Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid x:Name="UsersDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="150"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    <DataGridTemplateColumn Header="Actions" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit" Click="EditUser_Click"
                                            Padding="8,4" Margin="0,0,4,0"
                                            Background="#FFC107" Foreground="#333" BorderThickness="0"/>
                                    <Button Content="Reset Password" Click="ResetPassword_Click"
                                            Padding="8,4" Margin="0,0,4,0"
                                            Background="#9C27B0" Foreground="White" BorderThickness="0"/>
                                    <Button Content="Delete" Click="DeleteUser_Click"
                                            Padding="8,4"
                                            Background="#F44336" Foreground="White" BorderThickness="0"
                                            IsEnabled="{Binding CanDelete}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666" Margin="0,0,16,0"/>
            <Button Content="Close" Click="Close_Click" Padding="16,8"
                    Background="#757575" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
