<!--
  UserManagementWindow.xaml — Junction Users & Permissions
  Path: Views/UserManagementWindow.xaml
  Open from Admin menu → Users & Permissions.
-->
<Window x:Class="OpcUaCommunicationEngine.Views.UsSystem.Windows.Markup.XamlParseException: ''Provide value on 'System.Windows.StaticResourceExtension' threw an exception.' Line number '44' and line position '30'.'
erManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Junction — Quản lý người dùng"
        Height="820" Width="1280" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource FontSans}">

    <Window.Resources>
        <Style x:Key="SubnavRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource BorderStrongBrush}" CornerRadius="999">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"   Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- page head -->
            <RowDefinition Height="Auto"/>   <!-- tabs -->
            <RowDefinition Height="Auto"/>   <!-- stats -->
            <RowDefinition Height="*"/>      <!-- content (table | detail) -->
            <RowDefinition Height="Auto"/>   <!-- pagination -->
        </Grid.RowDefinitions>

        <!-- ============ Page head ============ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Quản lý người dùng" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Phân quyền truy cập vào Junction · ai mở được app, ai sửa được PLC, ai chỉ xem được."
                               FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Xuất danh sách" Height="36"/>
                    <Button Style="{StaticResource PrimaryButton}"   Content="+ Thêm người dùng" Height="36" Margin="8,0,0,0"
                            Click="AddUser_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Subnav tabs ============ -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="28,0">
                <RadioButton IsChecked="True" Style="{StaticResource SubnavRadio}" Content="Người dùng · 14"/>
                <RadioButton                  Style="{StaticResource SubnavRadio}" Content="Vai trò · 4"/>
                <RadioButton                  Style="{StaticResource SubnavRadio}" Content="Nhật ký · 218"/>
                <RadioButton                  Style="{StaticResource SubnavRadio}" Content="Chính sách"/>
            </StackPanel>
        </Border>

        <!-- ============ Stats strip ============ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1" Padding="28,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Users.Count, FallbackValue=14}"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="TỔNG NGƯỜI DÙNG" Margin="0,2,0,0"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource BorderHairlineBrush}" Margin="0,0,32,0"/>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="11"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="ĐANG HOẠT ĐỘNG" Margin="0,2,0,0"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource BorderHairlineBrush}" Margin="0,0,32,0"/>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="2"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="ADMIN" Margin="0,2,0,0"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource BorderHairlineBrush}" Margin="0,0,32,0"/>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="3"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="ĐĂNG NHẬP 24H" Margin="0,2,0,0"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource BorderHairlineBrush}" Margin="0,0,32,0"/>
                <StackPanel>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" Text="1"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" Text="KHÓA DO SAI MK" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ Content: table | detail ============ -->
        <Grid Grid.Row="3" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="*"/>      <!-- grid -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1" Padding="28,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="280" Height="30" FontSize="12" Padding="10,0"
                                 Background="{StaticResource SurfaceAltBrush}"
                                 Text="Tìm theo tên, email…"
                                 Foreground="{StaticResource TextTertiaryBrush}"/>
                        <Button Style="{StaticResource SecondaryButton}" Height="28" Content="Tất cả · 14" Margin="10,0,0,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Height="28" Content="Admin · 2"    Margin="6,0,0,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Height="28" Content="Engineer · 5" Margin="6,0,0,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Height="28" Content="Operator · 6" Margin="6,0,0,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Height="28" Content="Viewer · 1"   Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1" x:Name="UsersGrid" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          RowHeight="44" HeadersVisibility="Column" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="NGƯỜI DÙNG" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="999" Background="{Binding AvatarBrush, FallbackValue={StaticResource PrimaryBrush}}">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Login}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="VAI TRÒ" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,2" CornerRadius="999" Background="{Binding RoleBackBrush, FallbackValue={StaticResource PrimarySoftBrush}}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoleText}" Foreground="{Binding RoleForeBrush, FallbackValue={StaticResource PrimaryBrush}}"
                                                   FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ĐĂNG NHẬP GẦN NHẤT" Binding="{Binding LastLoginText}" Width="180"/>
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Margin="6,0,0,0" Text="{Binding StatusText}" FontFamily="{StaticResource FontMono}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TẠO BỞI" Binding="{Binding CreatedBy}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{StaticResource BorderHairlineBrush}"/>

            <!-- Detail panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="White">
                <StackPanel DataContext="{Binding SelectedUser}">
                    <!-- Detail head -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Grid Width="68" Height="68">
                            <Ellipse Width="64" Height="64" Fill="{Binding AvatarBrush, FallbackValue={StaticResource PrimaryBrush}}"/>
                            <Ellipse Width="68" Height="68" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontFamily="{StaticResource FontMono}"
                                       FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding Login}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,18">
                            <Button Style="{StaticResource SecondaryButton}" Height="30" Content="Sửa"        Click="EditUser_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Height="30" Content="Đặt lại MK" Margin="6,0,0,0" Click="ResetPassword_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Height="30" Content="Khóa"       Margin="6,0,0,0" Click="LockUser_Click"
                                    Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderHairlineBrush}" Height="1"/>

                    <StackPanel Margin="24,18,24,0">
                        <TextBlock Text="THÔNG TIN" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Vai trò"             Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RoleText}"   FontWeight="SemiBold" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bộ phận"             Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Department}" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mã NV"               Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EmployeeId}" FontFamily="{StaticResource FontMono}" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Tạo lúc"             Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedAtText}" FontFamily="{StaticResource FontMono}" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Đăng nhập gần nhất"  Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastLoginText}" FontFamily="{StaticResource FontMono}" Margin="0,4"/>
                        </Grid>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderHairlineBrush}" Height="1"/>

                    <StackPanel Margin="24,18,24,0">
                        <TextBlock Text="QUYỀN TRUY CẬP" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Permissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="13"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsGranted}" IsEnabled="{Binding IsEditable}" Style="{StaticResource PillSwitch}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,18">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Margin="6,0,0,0" Text="Vàng = bị khoá theo vai trò · không sửa được trực tiếp"
                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderHairlineBrush}" Height="1"/>

                    <StackPanel Margin="24,18,24,24">
                        <TextBlock Text="HOẠT ĐỘNG GẦN ĐÂY" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding RecentAudit}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding LevelBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource TextDisabledBrush}" Margin="6,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Pagination ============ -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <TextBlock Text="Hiển thị 1–10 của 14" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolbarButton}" Content="‹" Width="28" Height="28"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="1" Width="28" Height="28" Margin="2,0"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="2" Width="28" Height="28" Margin="2,0"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="›" Width="28" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
