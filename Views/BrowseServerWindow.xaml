<Window x:Class="OpcUaCommunicationEngine.Views.BrowseServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, FallbackValue='Duyệt OPC UA Server'}"
        Height="720" Width="1120"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="{StaticResource FontSans}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BrowseBtn" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2" ToolTip="{Binding Tooltip}">
                <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVariable}" Value="True">
                                    <Setter Property="Foreground" Value="#1B6CC8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeClass}" Value="Method">
                                    <Setter Property="Foreground" Value="#C76A00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeClass}" Value="Loading">
                                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DataType, StringFormat=' [{0}]'}"
                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsVariable, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ValueDisplay, StringFormat=' = {0}'}"
                           Foreground="#0E7C0E" FontSize="11" VerticalAlignment="Center"
                           Visibility="{Binding IsVariable, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text=" (đang tải...)" Foreground="{StaticResource TextTertiaryBrush}"
                           FontStyle="Italic" FontSize="11"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border Background="White" CornerRadius="12"
            BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- header -->
                <RowDefinition Height="Auto"/>  <!-- toolbar -->
                <RowDefinition Height="*"/>     <!-- body -->
                <RowDefinition Height="Auto"/>  <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ======== Header ======== -->
            <Grid Grid.Row="0" Margin="24,20,16,0" MouseLeftButtonDown="Head_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                        Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                    <TextBlock Text="⎇" FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle, FallbackValue='Duyệt OPC UA Server'}"
                               FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Chọn biến để thêm làm Tag giám sát · Double-click hoặc Enter để thêm"
                               FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Width="32" Height="32"
                        Click="CloseButton_Click" Content="✕"/>
            </Grid>

            <!-- ======== Toolbar ======== -->
            <Border Grid.Row="1" Margin="0,14,0,0"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,1"
                    Padding="16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource BrowseBtn}"
                            ToolTip="Làm mới cây node">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{StaticResource BorderHairlineBrush}" Margin="4,0,8,0"/>

                    <Button Command="{Binding AddSelectedTagCommand}" Style="{StaticResource PrimaryButton}"
                            Height="30" Padding="10,0" FontSize="12" Margin="0,0,4,0"
                            ToolTip="Thêm node đã chọn làm Tag (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm Tag" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddAllVariablesCommand}" Style="{StaticResource BrowseBtn}"
                            ToolTip="Thêm toàn bộ biến con của node đã chọn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thêm tất cả" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{StaticResource BorderHairlineBrush}" Margin="4,0,8,0"/>

                    <Button Command="{Binding CopyNodeIdCommand}" Style="{StaticResource BrowseBtn}"
                            ToolTip="Sao chép NodeId (Ctrl+C)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sao chép NodeId" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ReadValueCommand}" Style="{StaticResource BrowseBtn}"
                            ToolTip="Đọc giá trị hiện tại của node">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Đọc giá trị" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{StaticResource BorderHairlineBrush}" Margin="4,0,8,0"/>

                    <Button Command="{Binding ExpandAllCommand}" Style="{StaticResource BrowseBtn}">
                        <TextBlock Text="⬇ Mở rộng" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding CollapseAllCommand}" Style="{StaticResource BrowseBtn}">
                        <TextBlock Text="⬆ Thu gọn" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ======== Body ======== -->
            <Grid Grid.Row="2" Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Tree panel -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1" CornerRadius="8" Background="#FAFAFA">
                    <Grid>
                        <TreeView ItemsSource="{Binding RootNodes}"
                                  ItemTemplate="{StaticResource NodeTemplate}"
                                  ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                  BorderThickness="0" Background="Transparent"
                                  Padding="6"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddSelectedTagCommand}"/>
                                <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyNodeIdCommand}"/>
                            </TreeView.InputBindings>
                        </TreeView>

                        <!-- Loading overlay -->
                        <Border Background="#90FFFFFF" CornerRadius="8"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⟳" FontSize="32" Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Đang tải..." FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <!-- Right panel -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CHI TIẾT NODE"
                               Style="{StaticResource SectionLabelText}" Margin="0,0,0,6"/>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1" CornerRadius="8" Background="#FAFAFA" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedNodeDetails, Mode=OneWay}"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource FontMono}" FontSize="11"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Text="TAG ĐÃ THÊM"
                               Style="{StaticResource SectionLabelText}" Margin="0,12,0,6"/>

                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1" CornerRadius="8" Background="#FAFAFA">
                        <ListBox ItemsSource="{Binding SelectedTags}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                        <TextBlock Text="📊" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding NodeId}"
                                                       FontFamily="{StaticResource FontMono}" FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======== Footer ======== -->
            <Border Grid.Row="3" Margin="0,14,0,0"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid Margin="20,10">
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}">
                        <Run Text="{Binding StatusMessage, FallbackValue='Sẵn sàng'}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolbarButton}" Content="Huỷ"
                                Click="CloseButton_Click" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="✓ Xác nhận &amp; Đóng"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
