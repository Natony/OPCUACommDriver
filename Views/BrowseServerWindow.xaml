<Window x:Class="OpcUaCommunicationEngine.Views.BrowseServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- TreeView Item Style -->
        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <!-- Node Template -->
        <HierarchicalDataTemplate x:Key="NodeTemplate" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2" ToolTip="{Binding Tooltip}">
                <!-- Icon -->
                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>

                <!-- Display Name -->
                <TextBlock Text="{Binding DisplayName}" FontWeight="Normal" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVariable}" Value="True">
                                    <Setter Property="Foreground" Value="#0066CC"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeClass}" Value="Method">
                                    <Setter Property="Foreground" Value="#CC6600"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeClass}" Value="Loading">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Data Type for Variables -->
                <TextBlock Text="{Binding DataType, StringFormat=' [{0}]'}"
                           Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                           Visibility="{Binding IsVariable, Converter={StaticResource BoolToVis}}"/>

                <!-- Value for Variables -->
                <TextBlock Text="{Binding ValueDisplay, StringFormat=' = {0}'}"
                           Foreground="#009900" FontSize="11" VerticalAlignment="Center"
                           Visibility="{Binding IsVariable, Converter={StaticResource BoolToVis}}"/>

                <!-- Loading indicator -->
                <TextBlock Text=" (loading...)" Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Margin="0,0,0,10">
            <Button Command="{Binding RefreshCommand}" ToolTip="Refresh" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="14"/>
                    <TextBlock Text=" Refresh" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding AddSelectedTagCommand}" ToolTip="Add selected node as tag" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" FontSize="14"/>
                    <TextBlock Text=" Add Tag" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding AddAllVariablesCommand}" ToolTip="Add all variables under selected node" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥" FontSize="14"/>
                    <TextBlock Text=" Add All Variables" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding CopyNodeIdCommand}" ToolTip="Copy NodeId to clipboard" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="14"/>
                    <TextBlock Text=" Copy NodeId" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ReadValueCommand}" ToolTip="Read current value" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📖" FontSize="14"/>
                    <TextBlock Text=" Read Value" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ExpandAllCommand}" ToolTip="Expand all" Padding="8,4">
                <TextBlock Text="⬇️ Expand"/>
            </Button>
            <Button Command="{Binding CollapseAllCommand}" ToolTip="Collapse all" Padding="8,4">
                <TextBlock Text="⬆️ Collapse"/>
            </Button>
        </ToolBar>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Tree View -->
            <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4">
                <Grid>
                    <TreeView ItemsSource="{Binding RootNodes}"
                              ItemTemplate="{StaticResource NodeTemplate}"
                              ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              BorderThickness="0"
                              Padding="5">
                        <TreeView.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddSelectedTagCommand}"/>
                            <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyNodeIdCommand}"/>
                        </TreeView.InputBindings>
                    </TreeView>

                    <!-- Loading Overlay -->
                    <Border Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Loading..." FontSize="16" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right Panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- Node Details Header -->
                <TextBlock Grid.Row="0" Text="Selected Node Details" FontWeight="Bold" FontSize="14" Margin="5,0,0,5"/>

                <!-- Node Details -->
                <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding SelectedNodeDetails, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                    </ScrollViewer>
                </Border>

                <!-- Added Tags Header -->
                <TextBlock Grid.Row="2" Text="Added Tags" FontWeight="Bold" FontSize="14" Margin="5,10,0,5"/>

                <!-- Added Tags List -->
                <Border Grid.Row="3" BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4">
                    <ListBox ItemsSource="{Binding SelectedTags}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="📊" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding NodeId, StringFormat=' ({0})'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#E8E8E8" Margin="0,10,0,10" Padding="10,5" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#333"/>
        </Border>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="100" Padding="10,5" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
