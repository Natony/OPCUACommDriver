<Window x:Class="OpcUaCommunicationEngine.Views.EditPlcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Edit PLC"
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Identity Section -->
                <TextBlock Text="Identity" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Name *"/>
                        <TextBox x:Name="TxtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Description"/>
                        <TextBox x:Name="TxtDescription" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>
                    </StackPanel>
                </Border>

                <!-- Connection Section -->
                <TextBlock Text="Connection" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Endpoint URL *"/>
                        <TextBox x:Name="TxtEndpointUrl" Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox x:Name="ChkIsEnabled" Content="Enabled" IsChecked="{Binding IsEnabled}"/>
                    </StackPanel>
                </Border>

                <!-- Security Section -->
                <TextBlock Text="Security" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Security Policy"/>
                        <ComboBox x:Name="CmbSecurityPolicy"/>

                        <Label Content="Security Mode"/>
                        <ComboBox x:Name="CmbSecurityMode"/>

                        <Label Content="Username"/>
                        <TextBox x:Name="TxtUserName" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Password"/>
                        <PasswordBox x:Name="TxtPassword"/>

                        <Label Content="Certificate Path"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtCertificatePath" Text="{Binding CertificatePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10"/>
                            <Button Grid.Column="1" Content="..." Width="30" Click="BrowseCertificate_Click" Margin="0,0,0,10"/>
                        </Grid>

                        <Label Content="Private Key Path"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtPrivateKeyPath" Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10"/>
                            <Button Grid.Column="1" Content="..." Width="30" Click="BrowsePrivateKey_Click" Margin="0,0,0,10"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Session Configuration Section -->
                <TextBlock Text="Session Configuration" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <Label Content="Session Timeout (ms)"/>
                        <TextBox x:Name="TxtSessionTimeout" Text="{Binding SessionTimeout, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Keep Alive Interval (ms)"/>
                        <TextBox x:Name="TxtKeepAliveInterval" Text="{Binding KeepAliveInterval, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- Reconnect Configuration Section -->
                <TextBlock Text="Reconnect Configuration" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border BorderBrush="#CCC" BorderThickness="1" Background="White" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoReconnect" Content="Auto Reconnect" IsChecked="{Binding AutoReconnect}"/>

                        <Label Content="Reconnect Interval (ms)"/>
                        <TextBox x:Name="TxtReconnectInterval" Text="{Binding ReconnectInterval, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Max Reconnect Attempts (0 = unlimited)"/>
                        <TextBox x:Name="TxtMaxReconnectAttempts" Text="{Binding MaxReconnectAttempts, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="OK" Width="80" Padding="10,5" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Padding="10,5" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
