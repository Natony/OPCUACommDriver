<Window x:Class="OpcUaCommunicationEngine.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpcUaCommunicationEngine.ViewModels"
        xmlns:enums="clr-namespace:OpcUaCommunicationEngine.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Enum values for ComboBox -->
        <ObjectDataProvider x:Key="DataTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TagDataType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AccessModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TagAccessMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveConfigCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadConfigCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddPlcCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ToggleLogPanelCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="White" Padding="4">
            <MenuItem Header="_File">
                <MenuItem Header="_Load Configuration" Command="{Binding LoadConfigCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save Configuration" Command="{Binding SaveConfigCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Command="{Binding SaveConfigAsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Add PLC" Command="{Binding AddPlcCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Edit PLC" Command="{Binding EditPlcCommand}"/>
                <MenuItem Header="_Delete PLC" Command="{Binding DeletePlcCommand}"/>
                <Separator/>
                <MenuItem Header="Add _Tag" Command="{Binding AddTagCommand}"/>
                <MenuItem Header="Edit Ta_g" Command="{Binding EditTagCommand}"/>
                <MenuItem Header="Delete Tag" Command="{Binding DeleteTagCommand}"/>
            </MenuItem>
            <MenuItem Header="_Connection">
                <MenuItem Header="Connect _All" Command="{Binding ConnectAllCommand}"/>
                <MenuItem Header="_Disconnect All" Command="{Binding DisconnectAllCommand}"/>
                <Separator/>
                <MenuItem Header="Connect _Selected" Command="{Binding ConnectSelectedCommand}"/>
                <MenuItem Header="Disconnect S_elected" Command="{Binding DisconnectSelectedCommand}"/>
                <Separator/>
                <MenuItem Header="_Browse Server..." Command="{Binding BrowseServerCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="_Toggle Log Panel" Command="{Binding ToggleLogPanelCommand}" InputGestureText="Ctrl+L"/>
                <MenuItem Header="_Clear Logs" Command="{Binding ClearLogsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="1" Background="White">
            <ToolBar Band="1" BandIndex="1">
                <Button Command="{Binding LoadConfigCommand}" ToolTip="Load Configuration (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Load" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveConfigCommand}" ToolTip="Save Configuration (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Save" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding AddPlcCommand}" ToolTip="Add New PLC (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Add PLC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeletePlcCommand}" ToolTip="Delete Selected PLC">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding ConnectAllCommand}" ToolTip="Connect to All PLCs">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔌" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Connect All" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DisconnectAllCommand}" ToolTip="Disconnect from All PLCs">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛔" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Disconnect All" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding BrowseServerCommand}" ToolTip="Browse Server Nodes (Connect first)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="16" Margin="0,0,4,0"/>
                        <TextBlock Text="Browse Server" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - PLC List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PLC Devices" 
                               FontSize="16" FontWeight="SemiBold" 
                               Margin="0,0,0,12"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding PlcDevices}"
                             SelectedItem="{Binding SelectedPlc}"
                             BorderThickness="1"
                             BorderBrush="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Status Indicator -->
                                    <Ellipse Grid.Column="0" Grid.RowSpan="2"
                                             Width="12" Height="12"
                                             Margin="0,0,8,0"
                                             Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}"
                                             VerticalAlignment="Center"/>

                                    <!-- PLC Name -->
                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <!-- Endpoint URL -->
                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding EndpointUrl}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Right Panel - Tag List & Details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Tag List -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Tags" 
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedPlc.Name, StringFormat=' - {0}'}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasSelectedPlc, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Tag Toolbar -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding HasSelectedPlc, Converter={StaticResource BoolToVis}}">
                            <Button Command="{Binding AddTagCommand}" 
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" Margin="0,0,4,0"/>
                                    <TextBlock Text="Add Tag"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteTagCommand}"
                                    Padding="12,8"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️" Margin="0,0,4,0"/>
                                    <TextBlock Text="Delete"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Tag DataGrid -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedPlcTags}"
                                  SelectedItem="{Binding SelectedTag}"
                                  Visibility="{Binding HasSelectedPlc, Converter={StaticResource BoolToVis}}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <!-- Editable Name -->
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120"/>

                                <!-- Editable NodeId -->
                                <DataGridTextColumn Header="NodeId"
                                                    Binding="{Binding NodeId, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="180"/>

                                <!-- Read-only Value -->
                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding DisplayValue}"
                                                    Width="100"
                                                    IsReadOnly="True"/>

                                <!-- Read-only Quality -->
                                <DataGridTextColumn Header="Quality"
                                                    Binding="{Binding QualityText}"
                                                    Width="70"
                                                    IsReadOnly="True"/>

                                <!-- Read-only Timestamp -->
                                <DataGridTextColumn Header="Timestamp"
                                                    Binding="{Binding TimestampText}"
                                                    Width="90"
                                                    IsReadOnly="True"/>

                                <!-- DataType ComboBox -->
                                <DataGridComboBoxColumn Header="Data Type"
                                                        ItemsSource="{Binding Source={StaticResource DataTypeValues}}"
                                                        SelectedItemBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="90"/>

                                <!-- AccessMode ComboBox -->
                                <DataGridComboBoxColumn Header="Access"
                                                        ItemsSource="{Binding Source={StaticResource AccessModeValues}}"
                                                        SelectedItemBinding="{Binding AccessMode, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="90"/>

                                <!-- Editable Scan Rate -->
                                <DataGridTextColumn Header="Scan Rate"
                                                    Binding="{Binding ScanRate, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80"/>

                                <!-- Enabled Checkbox -->
                                <DataGridCheckBoxColumn Header="Enabled"
                                                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- No PLC Selected Message -->
                        <TextBlock Grid.Row="2"
                                   Text="Select a PLC to view its tags"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasSelectedPlc, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Height="4" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Center"
                              Background="Transparent"/>

                <!-- Properties Panel -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Properties" 
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- PLC Properties (when PLC selected but no Tag) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelectedPlc, Converter={StaticResource BoolToVis}}">
                            <Grid DataContext="{Binding SelectedPlc}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Endpoint:" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionStateText}" Margin="4"
                                           Foreground="{Binding ConnectionState, Converter={StaticResource StateToBrush}}"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Auto Reconnect:" FontWeight="SemiBold" Margin="0,4"/>
                                <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding AutoReconnect}" Margin="4" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Session Timeout:" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SessionTimeout}" Margin="4"/>

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="KeepAlive:" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding KeepAliveInterval}" Margin="4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Tags Count:" FontWeight="SemiBold" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Tags.Count}" Margin="4"/>

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Enabled:" FontWeight="SemiBold" Margin="0,4"/>
                                <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding IsEnabled}" Margin="4" VerticalAlignment="Center"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- No Selection Message -->
                        <TextBlock Grid.Row="1"
                                   Text="Select a PLC to view properties"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasSelectedPlc, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Log Panel Splitter -->
        <GridSplitter Grid.Row="3" Height="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#E0E0E0"
                      Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BoolToVis}}"/>

        <!-- Log Panel -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}"
                Margin="8,0,8,8"
                Visibility="{Binding IsLogPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log Panel Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Logs"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LogEntries.Count, StringFormat=' ({0} entries)'}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding ClearLogsCommand}"
                                ToolTip="Clear Logs"
                                Padding="8,4"
                                Margin="0,0,4,0">
                            <TextBlock Text="Clear"/>
                        </Button>
                        <Button Command="{Binding ToggleLogPanelCommand}"
                                ToolTip="Hide Log Panel (Ctrl+L)"
                                Padding="8,4">
                            <TextBlock Text="✕"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Log List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding LogEntries}"
                         BorderThickness="1"
                         BorderBrush="#E0E0E0"
                         Background="#FAFAFA"
                         FontFamily="Consolas"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         x:Name="LogListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}"
                                       Foreground="{Binding LevelColor, Converter={StaticResource StringToBrush}}"
                                       TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5" Background="White" Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PLCs: " Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PlcDevices.Count}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,4,0"
                             Fill="{Binding IsConnected, Converter={StaticResource StateToBrush}}"/>
                    <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Busy Overlay -->
        <Grid Grid.RowSpan="6"
              Background="#80000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="White" 
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="{Binding BusyMessage}" 
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
