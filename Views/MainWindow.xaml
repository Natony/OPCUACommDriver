<!--
  MainWindow.xaml v2 — Junction dockable workspace
  Replaces Views/MainWindow.xaml.

  Layout (uses CSS-grid-like Grid + GridSplitters):
    +---------+ titlebar (chromeless if WindowStyle=None)
    | menu    |
    | toolbar | + panel-toggle buttons (left/right/bottom)
    +---------+-----------+-------+
    |         | tag grid  |       |
    |  left   +-----------+ props |
    |  PLCs   | logger    |       |
    +---------+-----------+-------+
    | statusbar (brand-blue)      |
    +-----------------------------+

  Collapse model: each panel column/row has min-width 36 (rail).
  PanelHelper.Collapse(target, on) animates Width/Height between RestoreSize and 36.
-->
<Window x:Class="OpcUaCommunicationEngine.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OpcUaCommunicationEngine.Helpers"
        Title="{Binding WindowTitle, FallbackValue='Junction — OPC UA Engine'}"
        Height="900" Width="1400" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource FontSans}">

    <Window.InputBindings>
        <KeyBinding Key="S"  Modifiers="Ctrl" Command="{Binding SaveConfigCommand}"/>
        <KeyBinding Key="O"  Modifiers="Ctrl" Command="{Binding LoadConfigCommand}"/>
        <KeyBinding Key="N"  Modifiers="Ctrl" Command="{Binding AddPlcCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="L"  Modifiers="Ctrl+Alt" Command="{Binding ToggleLeftPanelCommand}"/>
        <KeyBinding Key="R"  Modifiers="Ctrl+Alt" Command="{Binding ToggleRightPanelCommand}"/>
        <KeyBinding Key="B"  Modifiers="Ctrl+Alt" Command="{Binding ToggleBottomPanelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Panel header bar — 32px tall, mono uppercase title + ctrl buttons -->
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="PanelCtrlButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F1419"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.08"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- menu -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- workspace -->
            <RowDefinition Height="28"/>     <!-- statusbar -->
        </Grid.RowDefinitions>

        <!-- ============ Menu ============ -->
        <Menu Grid.Row="0" Background="White" Padding="6,4" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_Load Configuration" Command="{Binding LoadConfigCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save Configuration" Command="{Binding SaveConfigCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..."          Command="{Binding SaveConfigAsCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Add PLC"    Command="{Binding AddPlcCommand}"   InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Edit PLC"   Command="{Binding EditPlcCommand}"/>
                <MenuItem Header="_Delete PLC" Command="{Binding DeletePlcCommand}"/>
                <Separator/>
                <MenuItem Header="Add _Tag"    Command="{Binding AddTagCommand}"/>
                <MenuItem Header="Edit Ta_g"   Command="{Binding EditTagCommand}"/>
                <MenuItem Header="Delete Tag"  Command="{Binding DeleteTagCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle PLC Devices panel"   Command="{Binding ToggleLeftPanelCommand}"   InputGestureText="Ctrl+Alt+L"/>
                <MenuItem Header="Toggle Properties panel"    Command="{Binding ToggleRightPanelCommand}"  InputGestureText="Ctrl+Alt+R"/>
                <MenuItem Header="Toggle Logger"              Command="{Binding ToggleBottomPanelCommand}" InputGestureText="Ctrl+Alt+B"/>
                <Separator/>
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Connection">
                <MenuItem Header="Connect _All"      Command="{Binding ConnectAllCommand}"/>
                <MenuItem Header="_Disconnect All"   Command="{Binding DisconnectAllCommand}"/>
                <Separator/>
                <MenuItem Header="Connect _Selected"     Command="{Binding ConnectSelectedCommand}"/>
                <MenuItem Header="Disconnect S_elected"  Command="{Binding DisconnectSelectedCommand}"/>
            </MenuItem>
            <MenuItem Header="_Admin">
                <MenuItem Header="_Users &amp; Permissions" Command="{Binding OpenUserManagementCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ============ Toolbar ============ -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderHairlineBrush}" BorderThickness="0,0,0,1" Height="44">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding LoadConfigCommand}" ToolTip="Load (Ctrl+O)" Content="Load"/>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SaveConfigCommand}" ToolTip="Save (Ctrl+S)" Content="Save"/>
                    <Separator Margin="6,8"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddPlcCommand}" Content="+ Add PLC" Margin="2,0"/>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding DeletePlcCommand}" Content="Delete"/>
                    <Separator Margin="6,8"/>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ConnectAllCommand}"    Content="Connect All"/>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding DisconnectAllCommand}" Content="Disconnect All"/>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}"       Content="Refresh"/>
                </StackPanel>

                <!-- Right side: panel toggles -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6,0">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleLeftPanelCommand}"   ToolTip="PLC Devices (Ctrl+Alt+L)" Content="◧"/>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleBottomPanelCommand}" ToolTip="Logger (Ctrl+Alt+B)"      Content="⬓"/>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleRightPanelCommand}"  ToolTip="Properties (Ctrl+Alt+R)"   Content="◨"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Workspace ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol"  Width="260" MinWidth="36"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"        MinWidth="320"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition x:Name="RightCol" Width="320" MinWidth="36"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="1"/>
                <RowDefinition x:Name="BottomRow" Height="200" MinHeight="36"/>
            </Grid.RowDefinitions>

            <!-- ============ LEFT: PLC Devices ============ -->
            <Border x:Name="LeftPanel" Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource PanelBorder}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource PanelHeaderText}"
                                       Text="PLC DEVICES" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="999" Padding="6,1" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock Text="{Binding PlcDevices.Count, FallbackValue=0}"
                                           FontFamily="{StaticResource FontMono}" FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource PanelCtrlButton}" Command="{Binding AddPlcCommand}" ToolTip="Add PLC" Content="+"/>
                            <Button Grid.Column="3" Style="{StaticResource PanelCtrlButton}" Click="ToggleLeft_Click" ToolTip="Collapse" Content="‹" Margin="0,0,4,0"/>
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding PlcDevices}"
                             SelectedItem="{Binding SelectedPlc}"
                             BorderThickness="0"
                             Background="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="6,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0A0F1419"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#141B2C7E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding EndpointUrl}" FontFamily="{StaticResource FontMono}"
                                                   FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="999" Padding="5,1"
                                            VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Tags.Count}" FontFamily="{StaticResource FontMono}" FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderHairlineBrush}"/>

            <!-- ============ CENTER: Tags ============ -->
            <Border x:Name="CenterPanel" Grid.Column="2" Grid.Row="0" Style="{StaticResource PanelBorder}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Background="White">
                        <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="0,0,0,2">
                            <Grid Margin="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource PanelHeaderText}" Foreground="{StaticResource PrimaryBrush}" Text="TAGS"/>
                                    <Border Background="#E4E7F4" CornerRadius="999" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding SelectedPlcTags.Count, FallbackValue=0}"
                                                   FontFamily="{StaticResource FontMono}" FontSize="10"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedPlc.Name, StringFormat=' — {0}'}"
                                               FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PanelCtrlButton}" Command="{Binding AddTagCommand}"    ToolTip="Add Tag" Content="+"/>
                                    <Button Style="{StaticResource PanelCtrlButton}" Command="{Binding BrowseServerCommand}" ToolTip="Browse server" Content="⌕"/>
                                    <Button Style="{StaticResource PanelCtrlButton}" Command="{Binding RefreshCommand}"   ToolTip="Refresh" Content="↻"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <DataGrid ItemsSource="{Binding SelectedPlcTags}"
                              SelectedItem="{Binding SelectedTag}"
                              IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn     Header="Name"       Binding="{Binding Name}"          Width="160"/>
                            <DataGridTextColumn     Header="NodeId"     Binding="{Binding NodeId}"        Width="220"/>
                            <DataGridTextColumn     Header="Value"      Binding="{Binding DisplayValue}"  Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn     Header="Quality"    Binding="{Binding QualityText}"   Width="90"  IsReadOnly="True"/>
                            <DataGridTextColumn     Header="Timestamp"  Binding="{Binding TimestampText}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn     Header="Type"       Binding="{Binding DataType}"      Width="80"/>
                            <DataGridTextColumn     Header="Access"     Binding="{Binding AccessMode}"    Width="80"/>
                            <DataGridTextColumn     Header="Scan"       Binding="{Binding ScanRate}"      Width="80"/>
                            <DataGridCheckBoxColumn Header="Enabled"    Binding="{Binding IsEnabled}"     Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ============ Bottom splitter ============ -->
            <GridSplitter Grid.Column="2" Grid.Row="1" Height="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderHairlineBrush}"/>

            <!-- ============ BOTTOM: Logger ============ -->
            <Border x:Name="BottomPanel" Grid.Column="2" Grid.Row="2" Style="{StaticResource PanelBorder}" Background="{StaticResource ChromeNavyBrush}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Height="32" Background="{StaticResource ChromeNavyBrush}"
                            BorderBrush="{StaticResource ChromeNavy2Brush}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PanelHeaderText}" Foreground="#9CA3AF" Text="LOGGER"/>
                                <Border Background="#1F2937" CornerRadius="999" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding LogCount, FallbackValue=0}"
                                               FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#E5E7EB"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PanelCtrlButton}" Foreground="#9CA3AF" Command="{Binding ClearLogsCommand}" ToolTip="Clear" Content="⌫"/>
                                <Button Style="{StaticResource PanelCtrlButton}" Foreground="#9CA3AF" Click="ToggleBottom_Click"           ToolTip="Collapse" Content="⌄"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding LogEntries}"
                             Background="{StaticResource ChromeNavyBrush}"
                             BorderThickness="0"
                             FontFamily="{StaticResource FontMono}" FontSize="11"
                             Foreground="#E5E7EB"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#6B7280"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Source}"  Foreground="#9CA3AF"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ Right splitter ============ -->
            <GridSplitter Grid.Column="3" Grid.RowSpan="3" Width="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderHairlineBrush}"/>

            <!-- ============ RIGHT: Properties ============ -->
            <Border x:Name="RightPanel" Grid.Column="4" Grid.RowSpan="3" Style="{StaticResource PanelBorder}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <Grid Margin="12,0">
                            <TextBlock Style="{StaticResource PanelHeaderText}" Text="PROPERTIES" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource PanelCtrlButton}" HorizontalAlignment="Right"
                                    Click="ToggleRight_Click" ToolTip="Collapse" Content="›"/>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedPlc}" Margin="0">
                            <!-- PLC Device group -->
                            <StackPanel Margin="14,14,14,10">
                                <TextBlock Style="{StaticResource SectionLabelText}" Text="PLC DEVICE" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"     Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoTextBox}" Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Status"   Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectionStateText}" Margin="0,5"
                                               Foreground="{Binding ConnectionState, Converter={StaticResource StateToBrush}}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tags"     Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Tags.Count}" Margin="0,5" FontFamily="{StaticResource FontMono}"/>
                                </Grid>
                            </StackPanel>

                            <Separator Background="{StaticResource BorderHairlineBrush}" Height="1" Margin="14,0"/>

                            <!-- Timing -->
                            <StackPanel Margin="14,14,14,10">
                                <TextBlock Style="{StaticResource SectionLabelText}" Text="TIMING" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Session timeout" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoTextBox}" Text="{Binding SessionTimeout}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="KeepAlive"        Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoTextBox}" Text="{Binding KeepAliveInterval}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reconnect"       Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoTextBox}" Text="{Binding ReconnectInterval}" Margin="0,2"/>
                                </Grid>
                            </StackPanel>

                            <Separator Background="{StaticResource BorderHairlineBrush}" Height="1" Margin="14,0"/>

                            <!-- Credentials -->
                            <StackPanel Margin="14,14,14,14">
                                <TextBlock Style="{StaticResource SectionLabelText}" Text="PLC CREDENTIALS" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Auth mode" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="UserName token" Margin="0,5" FontFamily="{StaticResource FontMono}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="UserName"  Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoTextBox}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Password"  Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,5"/>
                                    <PasswordBox Grid.Row="2" Grid.Column="1" Padding="8,5" MinHeight="30" Margin="0,2"
                                                 BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                 FontFamily="{StaticResource FontMono}" FontSize="12"/>
                                </Grid>
                                <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource FontMono}" FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap"
                                           Text="Áp dụng riêng cho PLC này · lưu mã hoá trong plc_config.json"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Statusbar (brand-blue) ============ -->
        <Border Grid.Row="3" Background="{StaticResource PrimaryBrush}">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                         Fill="{Binding IsConnected, Converter={StaticResource StateToBrush}}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E4E7F4" FontSize="11"/>
                <Rectangle Width="1" Height="14" Fill="#3A4699" Margin="14,0"/>
                <TextBlock FontSize="11" Foreground="#E4E7F4">
                    <Run Text="PLCs "/>
                    <Run Text="{Binding ConnectedPlcCount}" FontWeight="SemiBold" Foreground="White"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPlcCount}"/>
                    <Run Text=" connected"/>
                </TextBlock>
                <Rectangle Width="1" Height="14" Fill="#3A4699" Margin="14,0"/>
                <TextBlock FontSize="11" Foreground="#E4E7F4">
                    <Run Text="Tags "/>
                    <Run Text="{Binding TotalTagCount}" FontWeight="SemiBold" Foreground="White"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============ Busy overlay ============ -->
        <Grid Grid.RowSpan="4" Background="#800F1419"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="White" CornerRadius="10" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{x:Null}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.25" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding BusyMessage}" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
