{
  "Application": {
    "Name": "OPC UA Communication Engine",
    "Version": "1.0.0"
  },
  "Logging": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "OpcUa": {
    "ApplicationName": "OpcUaCommunicationEngine",
    "ApplicationUri": "urn:OpcUaCommunicationEngine:Client",
    "ProductUri": "urn:OpcUaCommunicationEngine",
    "CertificateStorePath": "./Certificates/own",
    "TrustedStorePath": "./Certificates/trusted",
    "RejectedStorePath": "./Certificates/rejected",
    "AutoAcceptUntrustedCertificates": true,
    "DefaultSessionTimeout": 60000,
    "DefaultOperationTimeout": 30000
  },
  "UI": {
    "Theme": "Light",
    "Language": "en-US",
    "RefreshInterval": 1000,
    "MaxVisibleTags": 1000,
    "EnableAnimations": true
  }
}
